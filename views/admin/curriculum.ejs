<div class="max-w-4xl mx-auto mt-10">
  <p class="text-sm text-gray-500 -mt-4 mb-4">Sắp xếp cấu trúc chương và bài học của khóa học: <strong><%= course.name %></strong>.</p>
  <div class="flex justify-end mb-6">
        <div class="relative" id="unit-add-wrapper">
            <button type="button" id="add-unit-btn" class="inline-flex items-center px-4 py-2 text-sm font-bold text-indigo-600 bg-indigo-50 rounded-xl hover:bg-indigo-100 transition-all">
                <svg class="w-5 h-5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                Thêm chương mới
            </button>

            <div id="unit-search-dropdown" class="hidden absolute right-0 mt-2 w-80 bg-white border border-gray-100 rounded-2xl shadow-xl z-50 overflow-hidden">
                <div class="p-2 bg-gray-50 border-b border-gray-100">
                    <input type="text" id="unit-search-input" class="w-full bg-white border border-gray-200 text-gray-900 text-sm rounded-xl focus:ring-indigo-500 focus:border-indigo-500 block p-2.5 outline-none" placeholder="Gõ để tìm chương có sẵn...">
                </div>
                <div id="unit-search-results" class="max-h-60 overflow-y-auto p-2 space-y-1">
                    </div>
            </div>
        </div>
    </div>
    
    <div id="loading-state" class="flex flex-col space-y-4 p-4 mt-6">
        <div class="h-24 bg-gray-100 rounded-2xl animate-pulse w-full"></div>
        <div class="h-24 bg-gray-100 rounded-2xl animate-pulse w-full"></div>
        <div class="h-24 bg-gray-100 rounded-2xl animate-pulse w-full"></div>
    </div>

    <div id="empty-state" class="hidden flex flex-col items-center justify-center p-12 border-2 border-dashed border-gray-200 rounded-3xl bg-gray-50/50">
    <div class="bg-white p-4 rounded-2xl shadow-sm mb-4">
        <svg class="w-12 h-12 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
        </svg>
    </div>
    <h3 class="text-lg font-bold text-gray-900">Chưa có chương trình học</h3>
    <p class="text-gray-500 text-sm mt-1 mb-6">Bắt đầu bằng cách thêm chương mới từ danh sách có sẵn.</p>
</div>
<form id="curriculum-form">
  <div id="units-container" class="space-y-4">
      
    </div>
    <div id="action-buttons-wrapper" class="hidden mt-10 px-6 flex items-center justify-end space-x-4">
      <button 
          type="button" 
          data-modal-target="popup-modal" 
          data-modal-toggle="popup-modal" 
          class="px-6 py-2.5 text-sm font-bold text-gray-500 hover:text-red-600 hover:bg-red-50 rounded-xl transition-all duration-200">
          Hủy bỏ thay đổi
      </button>

      <div id="popup-modal" tabindex="-1" class="hidden overflow-y-auto overflow-x-hidden fixed top-0 right-0 left-0 z-[60] justify-center items-center w-full md:inset-0 h-[calc(100%-1rem)] max-h-full bg-gray-900/50 backdrop-blur-sm">
          <div class="relative p-4 w-full max-w-md max-h-full">
              <div class="relative bg-white rounded-2xl shadow-xl border border-gray-100">
                  <button type="button" class="absolute top-3 end-2.5 text-gray-400 bg-transparent hover:bg-gray-100 hover:text-gray-900 rounded-lg text-sm w-8 h-8 ms-auto inline-flex justify-center items-center" data-modal-hide="popup-modal">
                      <svg class="w-3 h-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 14">
                          <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"/>
                      </svg>
                  </button>
      
                  <div class="p-6 text-center">
                      <div class="mx-auto mb-4 w-14 h-14 bg-red-50 rounded-full flex items-center justify-center">
                          <svg class="text-red-600 w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                          </svg>
                      </div>
                      <h3 class="mb-2 text-lg font-bold text-gray-900">Xác nhận hủy?</h3>
                      <p class="mb-6 text-sm text-gray-500">Mọi thông tin chỉnh sửa cấu trúc chương trình sẽ không được lưu lại. Bạn có chắc chắn muốn quay lại danh sách khóa học?</p>
                      
                      <div class="flex items-center space-x-3 justify-center">
                          <a href="javascript:void(0)" onclick="window.opener ? window.close() : window.location.href='/admin/course/list'" class="text-white bg-red-600 hover:bg-red-700 focus:ring-4 focus:outline-none focus:ring-red-300 font-bold rounded-xl text-sm inline-flex items-center px-5 py-2.5 text-center transition-all">
                              Có
                          </a>
                          <button data-modal-hide="popup-modal" type="button" class="text-gray-500 bg-white hover:bg-gray-100 focus:ring-4 focus:outline-none focus:ring-indigo-300 rounded-xl border border-gray-200 text-sm font-bold px-5 py-2.5 hover:text-gray-900 transition-all">
                              Không
                          </button>
                      </div>
                  </div>
              </div>
          </div>
      </div>
  
      <button 
          type="submit" 
          form="curriculum-form" 
          class="inline-flex items-center px-10 py-3 text-sm font-bold text-white bg-indigo-600 rounded-xl hover:bg-indigo-700 focus:ring-4 focus:ring-indigo-100 shadow-lg shadow-indigo-200 transform active:scale-95 transition-all duration-200">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
          </svg>
          Lưu chương trình học
      </button>
  </div>
</form>
</div>

<script src="/admin/assets/js/curriculum.js"></script>